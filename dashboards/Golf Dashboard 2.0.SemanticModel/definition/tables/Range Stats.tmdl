	column 'Smash Factor Gap' = ```
			
			VAR ClubType = 'Range Stats'[Club Type]
			VAR IdealSmash =
			    SWITCH(
			        TRUE(),
			        ClubType = "d", 1.48,
			        ClubType = "3w", 1.46,
			        ClubType = "3h", 1.44,
			        ClubType = "4i", 1.41,
			        ClubType = "5i", 1.4,
			        ClubType = "6i", 1.39,
			        ClubType = "7i", 1.38,
			        ClubType = "8i", 1.36,
			        ClubType = "9i", 1.35,
			        ClubType = "pw", 1.3,
			        ClubType = "gw", 1.28,
			        ClubType = "sw", 1.27,
			        ClubType = "lw", 1.26,
			        BLANK()
			    )
			RETURN
			ABS([Smash Factor] - IdealSmash)
			
			```
		lineageTag: dfebf301-2057-489e-8da9-3b51c019abd0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

