	column 'Club Group' = ```
			
			SWITCH(
			    TRUE(),
			    'Range Stats'[Club Type] IN {"4i", "5i", "6i"}, "Long Irons",
			    'Range Stats'[Club Type] IN {"7i", "8i", "9i"}, "Mid Irons",
			    'Range Stats'[Club Type] IN {"pw", "gw", "sw", "lw"}, "Wedges",
			    'Range Stats'[Club Type] IN {"3w", "3h"}, "Woods",
			    'Range Stats'[Club Type] IN {"d"}, "Driver",
			    "Other"
			)
			
			```
		lineageTag: a305828e-91eb-46c5-933f-05517ccf49d6
