	column TrajectoryLabel = ```
			
			IF (
			    [PointOrder] = 2,
			    [Club] & ": " & ROUND([LaunchAngle], 1) & "° / " & ROUND([Apex], 1) & " ft",
			    BLANK()
			)
			
			```
		isHidden
		lineageTag: 45ca2b3d-fd2b-4b93-a67c-9419c1d345cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Club Category' =
			
			SWITCH (
			    TRUE(),
			    [Club Type] = "d", "Driver",
			    [Club Type] IN {"3w", "3h"}, "Fairway Woods",
			    [Club Type] IN {"4i", "5i", "6i"}, "Long Irons",
			    [Club Type] IN {"7i", "8i", "9i"}, "Short Irons",
			    [Club Type] IN {"pw", "gw", "sw", "lw"}, "Wedges",
			    "Other"
			)
		lineageTag: 7ceaf50b-75f2-4274-bae3-cd3d0dc0bd6e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition ApexGraph = calculated
		mode: import
		source = ```
				
				GENERATE (
				    SUMMARIZE (
				        'Range Stats',
				        'Range Stats'[Club Type],
				        "AvgLaunchAngle", AVERAGE('Range Stats'[Launch Angle]),
				        "AvgApex", AVERAGE('Range Stats'[Apex])
				    ),
				    VAR AngleRad = RADIANS([AvgLaunchAngle])
				    VAR ApexY = [AvgApex]
				    VAR ApexX = ApexY / TAN(AngleRad)
				    RETURN
				        UNION (
				            ROW (
				                "PointOrder", 1,
				                "X", 0.0,
				                "Y", 0.0,
				                "Club", [Club Type],
				                "LaunchAngle", [AvgLaunchAngle],
				                "Apex", [AvgApex]
				            ),
				            ROW (
				                "PointOrder", 2,
				                "X", ApexX,
				                "Y", ApexY,
				                "Club", [Club Type],
				                "LaunchAngle", [AvgLaunchAngle],
				                "Apex", [AvgApex]
				            )
				        )
				)
				
				```

	annotation PBI_Id = e4dc504fc62f4a8bb8b5059c849a553d

