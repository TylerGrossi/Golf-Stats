	column LaunchAngleTooltip = ```
			
			IF (
			    [PointOrder] = 2,
			    [Club] & ": " & ROUND([LaunchAngle], 1) & "°",
			    BLANK()
			)
			
			```
		isHidden
		lineageTag: c2f2ae6a-23d7-4ae8-a15c-a1d95d637191
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Club Category' = ```
			
			SWITCH (
			    TRUE(),
			    [Club Type] = "d", "Driver",
			    [Club Type] IN {"3w", "3h"}, "Fairway Woods",
			    [Club Type] IN {"4i", "5i", "6i"}, "Long Irons",
			    [Club Type] IN {"7i", "8i", "9i"}, "Short Irons",
			    [Club Type] IN {"pw", "gw", "sw", "lw"}, "Wedges",
			    "Other"
			)
			
			```
		isHidden
		lineageTag: 29b1216f-864c-4f65-8b3c-9ac460393ac4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition LaunchAngleGraph = calculated
		mode: import
		source = ```
				
				GENERATE (
				    SUMMARIZE (
				        'Range Stats',
				        'Range Stats'[Club Type],
				        "AvgLaunchAngle", AVERAGE('Range Stats'[Launch Angle])
				    ),
				    UNION (
				        ROW (
				            "PointOrder", 1,
				            "X", 0.0,
				            "Y", 0.0,
				            "Club", [Club Type],
				            "LaunchAngle", [AvgLaunchAngle]
				        ),
				        ROW (
				            "PointOrder", 2,
				            "X", 1.0,
				            "Y", [AvgLaunchAngle],
				            "Club", [Club Type],
				            "LaunchAngle", [AvgLaunchAngle]
				        )
				    )
				)
				
				```

	annotation PBI_Id = 722ecb97c3164d6ba000bc34506a54cc

