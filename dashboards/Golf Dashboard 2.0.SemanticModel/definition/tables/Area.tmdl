	partition Area = calculated
		mode: import
		source =
				DATATABLE(
					"Area", STRING,
					"Order", INTEGER,
					{
						{"Driving", 1},
						{"Irons", 2},
						{"Wedges", 3},
						{"Putting", 4}
					}
				)

	annotation PBI_Id = Area

