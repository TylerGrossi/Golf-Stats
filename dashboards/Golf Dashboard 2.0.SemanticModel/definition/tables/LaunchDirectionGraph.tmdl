	column 'Club Category' = ```
			
			SWITCH (
			    TRUE(),
			    [Club Type] = "d", "Driver",
			    [Club Type] IN {"3w", "3h"}, "Fairway Woods",
			    [Club Type] IN {"4i", "5i", "6i"}, "Long Irons",
			    [Club Type] IN {"7i", "8i", "9i"}, "Short Irons",
			    [Club Type] IN {"pw", "gw", "sw", "lw"}, "Wedges",
			    "Other"
			)
			
			```
		isHidden
		lineageTag: 173f109d-c543-4277-bc8d-035115446218
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition LaunchDirectionGraph = calculated
		mode: import
		source = ```
				
				GENERATE (
				    SUMMARIZE (
				        'Range Stats',
				        'Range Stats'[Club Type],
				        "AvgLaunch", AVERAGE('Range Stats'[Launch Direction])
				    ),
				    UNION (
				        ROW (
				            "PointOrder", 1,
				            "X", 0.0,
				            "Y", 0.0,
				            "Club", [Club Type],
				            "Launch", [AvgLaunch]
				        ),
				        ROW (
				            "PointOrder", 2,
				            "X", [AvgLaunch],
				            "Y", 1.0,
				            "Club", [Club Type],
				            "Launch", [AvgLaunch]
				        )
				    )
				)
				
				```

	annotation PBI_Id = 7db6133a410c45dfa9e449252e3e48c9

