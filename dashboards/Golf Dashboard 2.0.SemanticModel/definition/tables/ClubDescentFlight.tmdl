	column 'Club Category' =
			
			SWITCH (
			    TRUE(),
			    [Club Type] = "d", "Driver",
			    [Club Type] IN {"3w", "3h"}, "Fairway Woods",
			    [Club Type] IN {"4i", "5i", "6i"}, "Long Irons",
			    [Club Type] IN {"7i", "8i", "9i"}, "Short Irons",
			    [Club Type] IN {"pw", "gw", "sw", "lw"}, "Wedges",
			    "Other"
			)
		lineageTag: 5357ee67-42ec-4806-9a17-8c078361256b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition ClubDescentFlight = calculated
		mode: import
		source = ```
				
				VAR Points = GENERATESERIES(0, 1, 0.05)  -- 21 points from Apex to Carry
				RETURN
				    GENERATE (
				        SUMMARIZE (
				            'Range Stats',
				            'Range Stats'[Club Type],
				            "AvgApex", AVERAGE('Range Stats'[Apex]),
				            "AvgDescent", AVERAGE('Range Stats'[Descent Angle])
				        ),
				        VAR Apex = [AvgApex]
				        VAR DescentRad = RADIANS([AvgDescent])
				        VAR ApexX = 0  -- we'll start X at 0 for simplicity
				        VAR Carry = Apex / TAN(DescentRad)
				        RETURN
				            ADDCOLUMNS (
				                Points,
				                "X", [Value] * Carry,  -- move from 0 to Carry
				                "Y", -4 * Apex / (Carry * Carry) * POWER(([Value] * Carry - Carry / 2), 2) + Apex,
				                "Club", [Club Type],
				                "ApexHeight", Apex,
				                "Descent", [AvgDescent],
				                "PointOrder", RANKX(Points, [Value])
				            )
				    )
				
				```

	annotation PBI_Id = d8bf112e4c764a99acc9c20c30fbd8db

