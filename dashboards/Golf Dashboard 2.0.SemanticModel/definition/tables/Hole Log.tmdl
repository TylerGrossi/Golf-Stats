	measure 'GIR Average Display' =
			
			VAR _avgGIR =
			    AVERAGEX(
			        FILTER(
			            'Hole Log',
			            NOT(ISBLANK('Hole Log'[GIR])) &&
			            'Hole Log'[GIR] <> "NC"
			        ),
			        SWITCH(
			            TRUE(),
			            'Hole Log'[GIR] = "✓", 1,
			            'Hole Log'[GIR] IN {"←","↑","→","↓","✗","v"}, 0,
			            0
			        )
			    )
			RETURN
			IF(ISBLANK(_avgGIR), "N/A", _avgGIR)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f71dada6-bb65-46bb-9d73-f0704674344b

	measure 'Fairway Average Display' =
			
			VAR _avgFairways =
			    AVERAGEX(
			        FILTER(
			            'Hole Log',
			            NOT(ISBLANK('Hole Log'[Fairways])) &&
			            'Hole Log'[Fairways] <> "NC"
			        ),
			        SWITCH(
			            TRUE(),
			            'Hole Log'[Fairways] = "✓", 1,
			            'Hole Log'[Fairways] IN {"←","↑","→","↓","✗"}, 0,
			            0
			        )
			    )
			RETURN
			IF(ISBLANK(_avgFairways), "N/A", _avgFairways)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5f67322d-e4dc-435f-a0cd-d9842398a7c7

	measure 'Scrambling %' = ```
			
			-- 1. Count holes where the GIR is 0, ✗, or an arrow
			VAR TotalMisses = 
			    CALCULATE(
			        COUNTROWS('Hole Log'),
			        'Hole Log'[GIR] IN {"0", "✗", "←", "↓", "→", "↑"}
			    )
			
			-- 2. Count how many of those specific misses resulted in Par or better
			VAR ParsSaved = 
			    CALCULATE(
			        COUNTROWS('Hole Log'),
			        'Hole Log'[GIR] IN {"0", "✗", "←", "↓", "→", "↑"},
			        'Hole Log'[Hole Score] <= 'Hole Log'[Par]
			    )
			
			-- 3. Divide Saves by Misses to get the true percentage
			RETURN
			DIVIDE(ParsSaved, TotalMisses, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 23631882-bdeb-49ba-8258-ef993e144901

	measure 'Hit %' =
			
			VAR _denom = COUNTROWS(FILTER('Hole Log', 'Hole Log'[Miss Direction] IN {"Hit","Left","Right","Long","Short","Missed"}))
			VAR _num = COUNTROWS(FILTER('Hole Log', 'Hole Log'[Miss Direction] = "Hit"))
			RETURN
			IF(_denom = 0, "--", DIVIDE(_num, _denom, 0))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 33dda70c-9edb-42ae-a72c-a7d99973c278

