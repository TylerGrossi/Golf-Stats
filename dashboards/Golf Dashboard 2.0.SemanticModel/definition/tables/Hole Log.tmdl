	column 'Miss Direction' =
			
			SWITCH(
			    TRUE(),
			    'Hole Log'[Fairways] = "✓", "Hit",
			    'Hole Log'[Fairways] = "←", "Left",
			    'Hole Log'[Fairways] = "→", "Right",
			    'Hole Log'[Fairways] = "↑", "Long",
			    'Hole Log'[Fairways] = "↓", "Short",
			    'Hole Log'[Fairways] = "✗", "Missed",
			    'Hole Log'[Fairways] = "NC", "NC",
			    "Other"
			)
		lineageTag: e4f06d4a-73db-4e56-b76b-c2c7e66f4241
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'GIR Direction' =
			
