table Handicap
	lineageTag: 3135e10a-de52-42ee-9277-428ca6792c21

	measure 'Handicap Index' = ```
			
			VAR CurrentDate = MAX('Handicap'[Date])
			VAR Ranked =
			    ADDCOLUMNS(
			        FILTER(
			            'Handicap',
			            NOT ISBLANK('Handicap'[Differential]) &&
			            'Handicap'[Date] <= CurrentDate
			        ),
			        "Rank", RANKX(
			            FILTER(
			                'Handicap',
			                NOT ISBLANK('Handicap'[Differential]) &&
			                'Handicap'[Date] <= CurrentDate
			            ),
			            'Handicap'[Differential],
			            ,
			            ASC
			        )
			    )
			VAR Top8 =
			    FILTER(Ranked, [Rank] <= 8)
			RETURN
			    IF(
			        COUNTROWS(Top8) >= 1,
			        ROUND(AVERAGEX(Top8, 'Handicap'[Differential]), 1),
			        BLANK()
			    )
			
			
			
			```
		lineageTag: ce224143-3239-4bf1-889a-0275925f9be8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Handicap Index Total' = ```
			
			VAR CurrentDate = CALCULATE(MAX('Handicap'[Date]))
			VAR CurrentGolfer = MAX('Handicap'[Golfer])
			
			-- Step 1: Valid rounds up to current date
			VAR ValidRounds =
			    FILTER(
			        ALL('Handicap'),
			        NOT ISBLANK('Handicap'[Differential]) &&
			        'Handicap'[Date] <= CurrentDate &&
			        'Handicap'[Golfer] = CurrentGolfer
			    )
			
			-- Step 2: Take latest 20 rounds
			VAR Latest20 =
			    TOPN(20, ValidRounds, 'Handicap'[Date], DESC)
			
			-- Step 3: Rank lowest differentials
			VAR Ranked =
			    ADDCOLUMNS(
			        Latest20,
			        "Rank",
			        RANKX(Latest20, 'Handicap'[Differential], , ASC)
			    )
			
			-- Step 4: Count number of rounds
			VAR RoundCount = COUNTROWS(Ranked)
			
			-- Step 5: Scores to use
			VAR ScoresToUse =
			    SWITCH(
			        TRUE(),
			        RoundCount IN {1, 2}, 1,
			        RoundCount = 3, 1,
			        RoundCount = 4, 1,
			        RoundCount = 5, 1,
			        RoundCount = 6, 2,
			        RoundCount IN {7, 8}, 2,
			        RoundCount IN {9, 10}, 3,
			        RoundCount IN {11, 12, 13, 14}, 4,
			        RoundCount IN {15, 16}, 5,
			        RoundCount IN {17, 18}, 6,
			        RoundCount = 19, 7,
			        RoundCount >= 20, 8,
			        0
			    )
			
			-- Step 6: WHS adjustment for 3+ rounds
			VAR Adjustment =
			    SWITCH(
			        TRUE(),
			        RoundCount = 3, -2,
			        RoundCount = 4, -1,
			        RoundCount = 5, 0,
			        RoundCount = 6, -1,
			        TRUE(), 0
			    )
			
			-- Step 7: Filter top N differentials
			VAR TopDiffs =
			    FILTER(Ranked, [Rank] <= ScoresToUse)
			
			-- Step 8: Final calculation
			RETURN
			    IF(
			        RoundCount >= 1,
			        TRUNC(
			            AVERAGEX(TopDiffs, 'Handicap'[Differential]) +
			            IF(RoundCount >= 3, Adjustment, 0),
			            1
			        )
			    )
			
			```
		lineageTag: d30dd284-b2d6-4c40-a003-f5bbd41b9c7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

