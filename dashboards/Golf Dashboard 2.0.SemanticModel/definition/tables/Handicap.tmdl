	column 'Handicap Index Snapshot' = ```
			
			VAR CurrentDate   = Handicap[Date]
			VAR CurrentGolfer = Handicap[Golfer]
			
			-- All valid rounds up to this point for this golfer
			VAR PriorRounds =
			    FILTER (
			        ALL ( Handicap ),
			        Handicap[Golfer] = CurrentGolfer &&
			        Handicap[Date] <= CurrentDate &&
			        NOT ISBLANK ( Handicap[Differential] )
			    )
			
			-- Take latest 20
			VAR Latest20 =
			    TOPN (
			        20,
			        PriorRounds,
			        Handicap[Date],
			        DESC
			    )
			
			-- Rank lowest differentials
			VAR Ranked =
			    ADDCOLUMNS (
			        Latest20,
			        "Rank",
			        RANKX (
			            Latest20,
			            Handicap[Differential],
			            ,
			            ASC
			        )
			    )
			
			-- Count how many rounds
			VAR RoundCount = COUNTROWS(Ranked)
			
			-- How many scores to use
			VAR ScoresToUse =
			    SWITCH (
			        TRUE(),
			        RoundCount IN {1, 2}, 1,
			        RoundCount = 3, 1,
			        RoundCount = 4, 1,
			        RoundCount = 5, 1,
			        RoundCount = 6, 2,
			        RoundCount IN {7, 8}, 2,
			        RoundCount IN {9, 10}, 3,
			        RoundCount IN {11, 12, 13, 14}, 4,
			        RoundCount IN {15, 16}, 5,
			        RoundCount IN {17, 18}, 6,
			        RoundCount = 19, 7,
			        RoundCount >= 20, 8,
			        0
			    )
			
			-- Adjustment for 3+ rounds
			VAR Adjustment =
			    SWITCH (
			        TRUE(),
			        RoundCount = 3, -2,
			        RoundCount = 4, -1,
			        RoundCount = 5, 0,
			        RoundCount = 6, -1,
			        TRUE(), 0
			    )
			
			-- Filter top N rounds
			VAR TopDiffs =
			    FILTER (
			        Ranked,
			        [Rank] <= ScoresToUse
			    )
			
			-- Final calculation
			VAR Result =
			    IF (
			        RoundCount >= 1,
			        TRUNC (
			            AVERAGEX ( TopDiffs, Handicap[Differential] ) +
			            IF (RoundCount >= 3, Adjustment, 0),
			            1
			        )
			    )
			
			RETURN Result
			
			```
		lineageTag: 6ab62bb7-7a78-49f3-90cb-33f9c9e9da33
