	measure 'Shots Under Par' = 'Golf Log'[Birdie Count] + 'Golf Log'[Eagle Count]
		formatString: 0
		lineageTag: a1548e02-49ba-42f4-b879-88e3289ea969

	measure 'Over Par by Hole' = ```
			
			VAR SelectedHole = SELECTEDVALUE('Golf Log'[Hole])
			VAR HoleX =
			    FILTER(
			        'Golf Log',
			        'Golf Log'[Hole] = SelectedHole
			    )
			
			VAR Score =
			    CALCULATE(SUM('Golf Log'[Hole Score]), HoleX)
			
			VAR Par =
			    CALCULATE(
			        SUMX(
			            HoleX,
			            LOOKUPVALUE(
			                'Course Stats'[Hole Par],
			                'Course Stats'[Course], 'Golf Log'[Course],
			                'Course Stats'[Hole], 'Golf Log'[Hole]
			            )
			        )
			    )
			
			RETURN
			Score - Par
			
			```
		formatString: 0
		lineageTag: 255bbaf1-90d9-4cca-80e3-65781fe04482

	measure 'Times Played' = ```
			COUNT('Golf Log'[Score])
			
			```
		formatString: 0
		lineageTag: e03420b0-821f-49b4-8425-befa3e6b81a9

	measure 'Sum Over Par by Hole' = ```
			
			VAR SelectedHole = SELECTEDVALUE('Golf Log'[Hole])
			
			VAR HoleData =
			    FILTER(
			        'Golf Log',
			        'Golf Log'[Hole] = SelectedHole
			    )
			
			VAR TotalScore =
			    CALCULATE(
			        SUM('Golf Log'[Hole Score]),
			        HoleData
			    )
			
			VAR TotalPar =
			    CALCULATE(
			        SUMX(
			            HoleData,
			            LOOKUPVALUE(
			                'Course Stats'[Hole Par],
			                'Course Stats'[Course], 'Golf Log'[Course],
			                'Course Stats'[Hole], 'Golf Log'[Hole]
			            )
			        )
			    )
			
			RETURN
			TotalScore - TotalPar
			
			```
		formatString: 0
		lineageTag: 5f6a7d93-0184-468b-a75a-6d7a6066fbb3

	measure 'Unique Course Count' = DISTINCTCOUNT('Golf Log'[Course])
		formatString: 0
		lineageTag: 5ab53e04-1a7f-4447-b28a-fc35894fbd0c

	measure 'Average Front 9 Score' = ```
			
			AVERAGEX(
			    VALUES('Golf Log'[RoundKey]),  -- or use a unique identifier for each round
			    CALCULATE(
			        SUM('Golf Log'[Hole Score]),
			        'Golf Log'[Hole Number] >= 1 && 'Golf Log'[Hole Number] <= 9
			    )
			)
			
			```
		lineageTag: ebc3731e-417d-4aff-a8e3-7dc8b4164268

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Back 9 Score' = ```
			
			AVERAGEX(
			    VALUES('Golf Log'[RoundKey]),  -- or another unique round identifier
			    CALCULATE(
			        SUM('Golf Log'[Hole Score]),
			        'Golf Log'[Hole Number] >= 10 && 'Golf Log'[Hole Number] <= 18
			    )
			)
			
			```
		lineageTag: dbebf615-bb20-4765-854f-d9b58eeae52a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

