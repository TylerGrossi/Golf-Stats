	column 'Score Result' = ```
			
			VAR Score = 'Golf Log'[Hole Score]
			VAR Par = RELATED('Course Stats'[Hole Par])
			RETURN 
			    SWITCH(
			        TRUE(),
			        ISBLANK(Score) || ISBLANK(Par), BLANK(),
			        Score = Par - 1, "Birdie",
			        Score = Par,     "Par",
			        Score = Par + 1, "Bogey",
			        Score = Par + 2, "Double Bogey",
			        Score = Par + 3, "Triple Bogey",
			        Score = Par + 4, "Quad Bogey",
			        Score < Par - 1, "Eagle"
			    )
			
			```
		lineageTag: 31da2e80-6288-4158-b440-6079edc62706
		summarizeBy: none

		annotation SummarizationSetBy = User

